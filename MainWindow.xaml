<Window x:Class="MemoryLab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MemoryLab" Width="1180" Height="850" MinWidth="960" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="#0F1115">
    <Window.Resources>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="#171A21"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F3F4F6"/>
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#20252E"/>
            <Setter Property="Foreground" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="#343B47"/>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="#20252E"/>
            <Setter Property="Foreground" Value="#F3F4F6"/>
            <Setter Property="Padding" Value="12,7"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="190"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Height="34" Margin="0,0,8,0" Content="Project &#x25BE;" Click="OpenActionsMenu_Click">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="New project" InputGestureText="Ctrl+N" Click="NewProject_Click"/>
                            <MenuItem Header="Open project..." InputGestureText="Ctrl+O" Click="OpenProject_Click"/>
                            <MenuItem Header="Recent projects" Click="RecentProjects_Click"/>
                            <Separator/>
                            <MenuItem Header="Project settings" Click="ProjectSettings_Click"/>
                            <MenuItem x:Name="AutoAttachMenuItem" Header="Auto attach" InputGestureText="F5" Click="AutoAttach_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Height="34" Margin="0,0,8,0" Content="Save" ToolTip="Save project (Ctrl+S)" Click="SaveProject_Click"/>
                <Button Height="34" Content="Tools &#x25BE;" Click="OpenActionsMenu_Click">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Pointer tools" Click="PointerTools_Click"/>
                            <MenuItem x:Name="AlignedScanMenuItem" Header="Fast scan (4-byte alignment)" IsCheckable="True" IsChecked="True"/>
                            <Separator/>
                            <MenuItem Header="Settings" Click="Settings_Click"/>
                            <MenuItem Header="About MemoryLab" Click="About_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="MemoryLab" FontSize="23" FontWeight="SemiBold"/>
                <TextBlock x:Name="ProjectStatusText" Margin="0,4,16,0" Foreground="#9CA3AF"
                           Text="Unsaved project" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <Button x:Name="RefreshGamesButton" DockPanel.Dock="Right" Height="28" Padding="10,3"
                                    Content="Refresh" Click="RefreshProcesses_Click"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Running games" Style="{StaticResource SectionTitle}"/>
                                <TextBlock x:Name="ProcessCountText" Margin="8,0,0,0" Foreground="#9CA3AF" VerticalAlignment="Center" Text="0"/>
                            </StackPanel>
                        </DockPanel>
                        <Grid Height="48" Margin="0,10,0,8">
                            <ComboBox x:Name="GameComboBox" MaxDropDownHeight="280"
                                      HorizontalContentAlignment="Stretch" AutomationProperties.Name="Running games"
                                      SelectionChanged="GameComboBox_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel ToolTip="{Binding DisplayName}">
                                            <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Details}" FontSize="11" Foreground="#9CA3AF" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock x:Name="NoGamesText" Foreground="#9CA3AF" VerticalAlignment="Center"
                                       Margin="10,0,36,0" IsHitTestVisible="False" Text="No games detected"/>
                        </Grid>
                        <Button x:Name="AttachButton" Height="34" Content="Attach to game" IsEnabled="False"
                                Background="#075985" BorderBrush="#0284C7" Click="Attach_Click"/>
                        <TextBlock x:Name="AttachedText" Margin="0,8,0,16" Foreground="#9CA3AF"
                                   Text="No game attached" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>
                        <Border Height="1" Background="#2B303B" Margin="0,0,0,14"/>

                        <TextBlock Foreground="#9CA3AF" Text="Scan type"/>
                        <ComboBox x:Name="ScanModeComboBox" Height="32" Margin="0,5,0,10" SelectedIndex="0"
                                  SelectionChanged="ScanModeComboBox_SelectionChanged">
                            <ComboBoxItem Tag="ExactValue" Content="Exact Value"/>
                            <ComboBoxItem Tag="UnknownInitialValue" Content="Unknown Initial Value"/>
                            <ComboBoxItem Tag="ChangedValue" Content="Changed Value"/>
                            <ComboBoxItem Tag="UnchangedValue" Content="Unchanged Value"/>
                            <ComboBoxItem Tag="IncreasedValue" Content="Increased Value"/>
                            <ComboBoxItem Tag="DecreasedValue" Content="Decreased Value"/>
                            <ComboBoxItem Tag="GreaterThan" Content="Greater Than"/>
                            <ComboBoxItem Tag="LessThan" Content="Less Than"/>
                            <ComboBoxItem Tag="Between" Content="Between"/>
                            <ComboBoxItem Tag="IncreasedBy" Content="Increased By"/>
                            <ComboBoxItem Tag="DecreasedBy" Content="Decreased By"/>
                        </ComboBox>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="Value1Label" Foreground="#9CA3AF" Text="Value"/>
                                <TextBox x:Name="ScanValueTextBox" Height="32" Margin="0,5,0,0" Padding="8,4" Text="100"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Foreground="#9CA3AF" Text="Value type"/>
                                <ComboBox x:Name="ScanValueTypeComboBox" Height="32" Margin="0,5,0,0" SelectedIndex="0">
                                    <ComboBoxItem Content="Int32"/>
                                    <ComboBoxItem Content="Float"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="Value2Label" Foreground="#9CA3AF" Text="Second value" Visibility="Collapsed"/>
                        <TextBox x:Name="ScanValue2TextBox" Height="32" Margin="0,5,0,10" Padding="8,4" Text="200" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="FirstScanButton" Height="34" Content="First scan" Click="FirstScan_Click"
                                    Background="#075985" BorderBrush="#0284C7"/>
                            <Button x:Name="NextScanButton" Grid.Column="2" Height="34" Content="Next scan" Click="NextScan_Click" IsEnabled="False"/>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Height="30" Content="Reset" Click="NewScan_Click"/>
                            <Button x:Name="CancelScanButton" Grid.Column="2" Height="30" Content="Cancel" Click="CancelScan_Click" IsEnabled="False"/>
                        </Grid>
                        <ProgressBar x:Name="ScanProgressBar" Height="4" Margin="0,12,0,0" Minimum="0" Maximum="100" Value="0"/>
                        <TextBlock x:Name="ScanInfoText" Foreground="#9CA3AF" Margin="0,6,0,0" Text="Ready to scan." TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel LastChildFill="True">
                        <TextBlock x:Name="ResultCountText" DockPanel.Dock="Right" Foreground="#9CA3AF" Text="0 results"/>
                        <TextBlock Text="Scan results" Style="{StaticResource SectionTitle}"/>
                    </DockPanel>
                    <DataGrid x:Name="ResultsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Extended" HeadersVisibility="Column" BorderThickness="0"
                              GridLinesVisibility="None" CanUserAddRows="False" EnableRowVirtualization="True"
                              MouseDoubleClick="ResultsGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Address" Binding="{Binding AddressText}" Width="1.5*"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                            <DataGridTextColumn Header="Previous" Binding="{Binding PreviousValue}" Width="*"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding ValueType}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel Grid.Row="4" LastChildFill="False">
                        <Button DockPanel.Dock="Right" Height="32" Content="Add address" Click="AddSelectedAddress_Click"/>
                        <Button Height="32" Content="More &#x25BE;" Click="OpenActionsMenu_Click">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Memory viewer" Click="ViewSelectedResult_Click"/>
                                    <MenuItem Header="Pointer tools" Click="PointerFromResult_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource Panel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel LastChildFill="True">
                    <TextBlock x:Name="AddressCountText" DockPanel.Dock="Right" Foreground="#9CA3AF" Text="0 entries"/>
                    <TextBlock Text="Saved addresses" Style="{StaticResource SectionTitle}"/>
                </DockPanel>
                <DataGrid x:Name="AddressGrid" Grid.Row="2" AutoGenerateColumns="False" SelectionMode="Extended"
                          HeadersVisibility="Column" BorderThickness="0" GridLinesVisibility="None"
                          CanUserAddRows="False" EnableRowVirtualization="True" MouseDoubleClick="AddressGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Freeze" Binding="{Binding IsFrozen, Mode=TwoWay}" Width="65"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description, Mode=TwoWay}" Width="*"/>
                        <DataGridTextColumn Header="Group" Binding="{Binding Group, Mode=TwoWay}" Width="110"/>
                        <DataGridTextColumn Header="Address" Binding="{Binding AddressText}" IsReadOnly="True" Width="180"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding ValueType}" IsReadOnly="True" Width="70"/>
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" IsReadOnly="True" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Height="30" Margin="0,0,8,0" Content="More &#x25BE;" Click="OpenActionsMenu_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Memory viewer" Click="ViewAddress_Click"/>
                                <MenuItem Header="Pointer tools" Click="PointerFromAddress_Click"/>
                                <MenuItem Header="Make module relative" Click="MakeModuleRelative_Click"/>
                                <MenuItem Header="Toggle freeze" InputGestureText="F6" Click="ToggleFreeze_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Height="30" Margin="0,0,8,0" Content="Edit value" Click="EditAddress_Click"/>
                    <Button Height="30" Content="Remove" Click="RemoveAddress_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <TextBlock x:Name="StatusText" Grid.Row="5" Foreground="#9CA3AF" Margin="0,10,0,0"
                   Text="Open a game to get started." TextTrimming="CharacterEllipsis"/>
    </Grid>
</Window>
