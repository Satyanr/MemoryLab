<Window x:Class="MemoryLab.ProjectSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project Settings"
        Width="460"
        Height="300"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0F1115">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Project Settings"
                   Foreground="White"
                   FontSize="20"
                   FontWeight="SemiBold"/>

        <TextBlock Grid.Row="2"
                   Foreground="#9CA3AF"
                   Text="Project name"/>
        <TextBox x:Name="ProjectNameTextBox"
                 Grid.Row="4"
                 Height="34"
                 Padding="8,6"/>

        <TextBlock Grid.Row="6"
                   Foreground="#9CA3AF"
                   Text="Auto-attach process name"/>

        <TextBox x:Name="ProcessNameTextBox"
                 Grid.Row="7"
                 Margin="0,5,0,0"
                 Height="34"
                 Padding="8,6"/>

        <StackPanel Grid.Row="8"
                    Margin="0,16,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="90"
                    Height="34"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Content="Cancel"/>
            <Button Width="90"
                    Height="34"
                    IsDefault="True"
                    Click="Save_Click"
                    Content="Save"/>
        </StackPanel>
    </Grid>
</Window>
