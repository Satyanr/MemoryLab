<Window x:Class="MemoryLab.MemoryViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Memory Viewer"
        Width="1220"
        Height="720"
        MinWidth="980"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="#0F1115">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Padding="14"
                CornerRadius="10"
                Background="#171A21"
                BorderBrush="#2B303B"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Foreground="#9CA3AF"
                           Text="Address"/>

                <TextBox x:Name="AddressTextBox"
                         Grid.Column="1"
                         Height="34"
                         Padding="8,6"
                         FontFamily="Consolas"
                         Text="0x0000000000000000"/>

                <Button Grid.Column="3"
                        Width="86"
                        Height="34"
                        Click="Go_Click"
                        Content="Go"/>

                <Button Grid.Column="5"
                        Width="86"
                        Height="34"
                        Click="PreviousPage_Click"
                        Content="Previous"/>

                <Button Grid.Column="7"
                        Width="86"
                        Height="34"
                        Click="NextPage_Click"
                        Content="Next"/>

                <CheckBox x:Name="LiveRefreshCheckBox"
                          Grid.Column="9"
                          VerticalAlignment="Center"
                          Foreground="#E5E7EB"
                          IsChecked="True"
                          Content="Live refresh"/>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Padding="12"
                CornerRadius="10"
                Background="#171A21"
                BorderBrush="#2B303B"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Foreground="#9CA3AF" Text="Region Base"/>
                    <TextBlock x:Name="RegionBaseText"
                               Margin="0,4,0,0"
                               FontFamily="Consolas"
                               Foreground="White"
                               Text="-"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Foreground="#9CA3AF" Text="Region Size"/>
                    <TextBlock x:Name="RegionSizeText"
                               Margin="0,4,0,0"
                               FontFamily="Consolas"
                               Foreground="White"
                               Text="-"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Foreground="#9CA3AF" Text="State / Type"/>
                    <TextBlock x:Name="RegionStateTypeText"
                               Margin="0,4,0,0"
                               Foreground="White"
                               Text="-"/>
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Foreground="#9CA3AF" Text="Protection"/>
                    <TextBlock x:Name="RegionProtectionText"
                               Margin="0,4,0,0"
                               Foreground="White"
                               Text="-"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4"
                Padding="10"
                CornerRadius="10"
                Background="#171A21"
                BorderBrush="#2B303B"
                BorderThickness="1">
            <DataGrid x:Name="HexGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      Background="#11141A"
                      Foreground="#E5E7EB"
                      BorderBrush="#2B303B"
                      GridLinesVisibility="None"
                      RowBackground="#11141A"
                      AlternatingRowBackground="#151922"
                      CanUserAddRows="False"
                      FontFamily="Consolas"
                      EnableRowVirtualization="True"
                      SelectionUnit="FullRow">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="155"/>
                    <DataGridTextColumn Header="00" Binding="{Binding Hex00}" Width="42"/>
                    <DataGridTextColumn Header="01" Binding="{Binding Hex01}" Width="42"/>
                    <DataGridTextColumn Header="02" Binding="{Binding Hex02}" Width="42"/>
                    <DataGridTextColumn Header="03" Binding="{Binding Hex03}" Width="42"/>
                    <DataGridTextColumn Header="04" Binding="{Binding Hex04}" Width="42"/>
                    <DataGridTextColumn Header="05" Binding="{Binding Hex05}" Width="42"/>
                    <DataGridTextColumn Header="06" Binding="{Binding Hex06}" Width="42"/>
                    <DataGridTextColumn Header="07" Binding="{Binding Hex07}" Width="42"/>
                    <DataGridTextColumn Header="08" Binding="{Binding Hex08}" Width="42"/>
                    <DataGridTextColumn Header="09" Binding="{Binding Hex09}" Width="42"/>
                    <DataGridTextColumn Header="0A" Binding="{Binding Hex0A}" Width="42"/>
                    <DataGridTextColumn Header="0B" Binding="{Binding Hex0B}" Width="42"/>
                    <DataGridTextColumn Header="0C" Binding="{Binding Hex0C}" Width="42"/>
                    <DataGridTextColumn Header="0D" Binding="{Binding Hex0D}" Width="42"/>
                    <DataGridTextColumn Header="0E" Binding="{Binding Hex0E}" Width="42"/>
                    <DataGridTextColumn Header="0F" Binding="{Binding Hex0F}" Width="42"/>
                    <DataGridTextColumn Header="ASCII" Binding="{Binding Ascii}" Width="180"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="6"
                Padding="10"
                CornerRadius="8"
                Background="#171A21"
                BorderBrush="#2B303B"
                BorderThickness="1">
            <TextBlock x:Name="StatusText"
                       Foreground="#9CA3AF"
                       Text="Ready."/>
        </Border>
    </Grid>
</Window>
