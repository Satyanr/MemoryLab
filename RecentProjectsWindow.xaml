<Window x:Class="MemoryLab.RecentProjectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recent Projects"
        Width="680"
        Height="420"
        MinWidth="560"
        MinHeight="340"
        WindowStartupLocation="CenterOwner"
        Background="#0F1115">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Recent Projects"
                   Foreground="White"
                   FontSize="22"
                   FontWeight="SemiBold"/>

        <ListBox x:Name="RecentListBox"
                 Grid.Row="2"
                 Background="#11141A"
                 Foreground="#E5E7EB"
                 BorderBrush="#2B303B"
                 MouseDoubleClick="RecentListBox_MouseDoubleClick"/>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="100"
                    Height="34"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Content="Cancel"/>
            <Button Width="100"
                    Height="34"
                    IsDefault="True"
                    Click="Open_Click"
                    Content="Open"/>
        </StackPanel>
    </Grid>
</Window>
