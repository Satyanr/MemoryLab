<Window x:Class="MemoryLab.EditValueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Value"
        Width="420"
        Height="240"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0F1115">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Edit Memory Value"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="White"/>

        <TextBlock x:Name="InfoText"
                   Grid.Row="2"
                   Foreground="#9CA3AF"
                   TextWrapping="Wrap"/>

        <TextBox x:Name="ValueTextBox"
                 Grid.Row="4"
                 Height="36"
                 Padding="8,6"/>

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="90"
                    Height="34"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Content="Cancel"/>

            <Button Width="90"
                    Height="34"
                    IsDefault="True"
                    Click="Save_Click"
                    Content="Write"/>
        </StackPanel>
    </Grid>
</Window>
